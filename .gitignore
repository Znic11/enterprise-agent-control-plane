# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Runtime artifacts (regenerable; large result files not tracked at baseline)
results/
logs/
*.log

# Databases / archives (restore via gym_dbs.zip, see README)
gym_dbs/
Domain Wise DBs and Task-DB Mappings/
*.db

# Server-side config holds real API keys — never commit conf/, only conf.example/
conf/
conf/llm/*.local.json

# Data dir: only the curated sample set is tracked
data/*
!data/revised/

# Environment / secrets (.env contains cloud credentials — never commit)
.env

# WorkBuddy session data
.workbuddy/

# OS / IDE
.DS_Store
.idea/
.vscode/
